# Environment Configuration Template for NomaanOS Sentinel
# Copy this file to .env and adjust values for your local environment.
# Never commit real secrets or production credentials to version control.

# Application Environment
NODE_ENV=development

# Web Frontend Configuration
WEB_PORT=3000

# Express API Configuration
API_PORT=4000
API_URL=http://localhost:4000
LOG_LEVEL=info

# PostgreSQL Configuration
# Note: Host port defaults to 5433 to avoid conflicts if 5432 is in use on host.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=nomaanos_sentinel
DATABASE_USER=sentinel_dev
DATABASE_PASSWORD=replace_with_local_secret
DATABASE_URL=postgresql://sentinel_dev:replace_with_local_secret@localhost:5433/nomaanos_sentinel

# Security & Parser Configuration
PARSER_MAX_FILE_BYTES=10485760
PARSER_MAX_LINES=50000

# Authentication & Session Security
SESSION_SECRET=replace_with_random_64_byte_hex_secret
SESSION_COOKIE_NAME=sentinel_session
SESSION_EXPIRATION_DAYS=7

# Email Provider Configuration (development or smtp)
# Set EMAIL_PROVIDER=development for local in-memory recording, or EMAIL_PROVIDER=smtp for real Mailtrap Email Sandbox delivery
EMAIL_PROVIDER=development
EMAIL_FROM="NomaanOS Sentinel <noreply@sentinel.local>"
# Mailtrap Email Sandbox SMTP Settings (from Mailtrap Inbox -> Inboxes -> SMTP Settings -> Integration)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=replace_with_mailtrap_sandbox_username
SMTP_PASSWORD=replace_with_mailtrap_sandbox_password
SMTP_SECURE=false
WEB_URL=http://localhost:3000

# Private Storage & Log Upload Limits
STORAGE_DIR=storage
UPLOAD_MAX_FILE_BYTES=5242880
UPLOAD_MAX_LINES=50000
UPLOAD_MAX_LINE_LENGTH_BYTES=16384
UPLOAD_PROCESSING_TIMEOUT_MS=30000

# Background Worker & Python Parser Settings
PYTHON_PATH=python
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_SECONDS=45
WORKER_MAX_ATTEMPTS=3

# AI Investigation Assistant Provider Settings (gemini, openai, mock, none)
AI_PROVIDER=none
AI_API_KEY=replace_with_ai_provider_api_key
AI_MODEL=gemini-1.5-pro
AI_TIMEOUT_MS=30000
AI_RATE_LIMIT_PER_MINUTE=10

# Razorpay Subscriptions & Payment Integration
# Get your Test Mode API keys from Razorpay Dashboard: Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
# Configured in Razorpay Dashboard -> Webhooks (e.g. https://your-domain.com/api/v1/billing/webhooks/razorpay)
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# Secure Outbound Alert Webhook Settings
OUTBOUND_WEBHOOK_TIMEOUT_MS=5000
OUTBOUND_WEBHOOK_MAX_RETRIES=3
OUTBOUND_WEBHOOK_ALLOW_INSECURE_HTTP=false



