{
  "name": "@nomaanos/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "NomaanOS Sentinel API Server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
