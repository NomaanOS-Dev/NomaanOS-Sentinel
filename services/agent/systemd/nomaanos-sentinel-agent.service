[Unit]
Description=NomaanOS Sentinel Linux Security Telemetry Agent
Documentation=https://github.com/nomaanos/sentinel
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentinel-agent
Group=adm

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=SENTINEL_CONFIG_PATH=/etc/nomaanos-sentinel/agent.json

# Execution
ExecStart=/mnt/d/Projects/6-NomaanOS-Sentinel/services/agent/.venv/bin/sentinel-agent start
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

# Security Hardening for Ubuntu 24.04 LTS
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Filesystem Access
ReadOnlyPaths=/var/log/auth.log
ReadWritePaths=/var/lib/nomaanos-sentinel /etc/nomaanos-sentinel

[Install]
WantedBy=multi-user.target

